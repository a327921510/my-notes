{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "electron",
    "types": ["node"],
    "lib": ["ES2022"],
    "resolveJsonModule": true
  },
  "include": ["electron/**/*.ts"]
}
